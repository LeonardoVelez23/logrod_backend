PORT=3000
NODE_ENV=development

# Obligatorio. Secreto para firmar los JWT (generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# Dominios web permitidos, separados por coma (p. ej. https://saborpolitecnico.netlify.app).
# Vacío: cualquiera en desarrollo, ninguno en producción. La app móvil no lo necesita.
CORS_ORIGIN=
# Zona horaria de la fecha y hora de los pedidos (por defecto America/Guayaquil).
# APP_TIMEZONE=America/Guayaquil
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.muoqfepuzoozilwgclkx.supabase.co:5432/postgres


# Pago con tarjeta por Payphone (RF-22). Sin estos tres valores el pago con
# tarjeta queda desactivado. Se obtienen en Payphone Developer → aplicación
# WEB → Credenciales. Usar una aplicación en ambiente PRUEBAS: no hay cobros reales.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Página de retorno de este backend (debe coincidir con la "URL de respuesta"
# de la aplicación en Payphone). En desarrollo, con un túnel (ngrok):
# https://<tu-dominio>.ngrok-free.app/pagos/payphone/retorno
PAYPHONE_RESPONSE_URL=
# Enlace para volver a la app (por defecto saborpolitecnico://app).
# APP_DEEP_LINK=saborpolitecnico://app
